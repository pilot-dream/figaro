{
  "name": "figaro",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "postinstall": "cd server && npx prisma@5.22.0 generate",
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "build": "npm run build --workspace=server && npm run build --workspace=client"
  },
  "devDependencies": {
    "concurrently": "^10.0.4"
  },
  "dependencies": {
    "firebase": "^12.17.0"
  }
}
