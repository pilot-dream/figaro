generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String   @id @db.Uuid
  name                 String
  slug                 String?  @unique
  phone                String?
  role                 String   @default("CLIENT")
  avatarUrl            String?  @map("avatar_url")
  ownerId              String?  @map("owner_id") @db.Uuid
  notes                String?
  specialty            String?

  // Enterprise: Hierarquia Matriz → Filial (self-relation entre OWNERs)
  parentId             String?  @map("parent_id") @db.Uuid
  branchName           String?  @map("branch_name") // Nome da unidade (ex: "Unidade Centro")
  branchAddress        String?  @map("branch_address") // Endereço da unidade
  
  // Comissionamento (para BARBERS)
  commissionType       String   @default("PERCENTAGE") @map("commission_type") // 'PERCENTAGE' | 'FIXED'
  commissionValue      Float    @default(0)             @map("commission_value")

  // Assinatura provisória (Integração Cakto Pay B2B SaaS)
  subscriptionPlan     String   @default("FREE")        @map("subscription_plan")
  saasStatus           String   @default("TRIAL")       @map("saas_status") // 'TRIAL' | 'ACTIVE' | 'PAST_DUE' | 'CANCELED'
  trialEndsAt          DateTime?                        @map("trial_ends_at")
  gracePeriodEndsAt    DateTime?                        @map("grace_period_ends_at")
  caktoCustomerId      String?                          @map("cakto_customer_id")
  caktoSubscriptionId  String?                          @map("cakto_subscription_id")
  
  googleRefreshToken   String?  @map("google_refresh_token")
  googleEmail          String?  @map("google_email")
  googleSyncEnabled    Boolean  @default(false) @map("google_sync_enabled")
  googleSyncBusyTimes  Boolean  @default(false) @map("google_sync_busy_times")
  
  whatsappInstanceId   String?  @map("whatsapp_instance_id")
  whatsappStatus       String?  @default("DISCONNECTED") @map("whatsapp_status")
  whatsappEnabled      Boolean  @default(false) @map("whatsapp_enabled")
  whatsappReminder24h  Boolean  @default(false) @map("whatsapp_reminder_24h")
  whatsappReminder2h   Boolean  @default(false) @map("whatsapp_reminder_2h")
  whatsappTemplateBase String?  @default("Olá {{client_name}}, lembrete do seu agendamento: {{services}} com {{barber_name}} às {{time}}.") @map("whatsapp_template_base")
  
  createdAt            DateTime @default(now()) @map("created_at")

  appointments  Appointment[] @relation("ClientAppointments")
  barberSlots   Appointment[] @relation("BarberAppointments")
  owner         User?         @relation("TeamMembers", fields: [ownerId], references: [id])
  teamMembers   User[]        @relation("TeamMembers")
  parent        User?         @relation("BranchNetwork", fields: [parentId], references: [id])
  branches      User[]        @relation("BranchNetwork")
  blockedTimes  BlockedTime[]
  clientWaitlists Waitlist[]  @relation("ClientWaitlist")
  barberWaitlists Waitlist[]  @relation("BarberWaitlist")
  
  subscriptions CustomerSubscription[] @relation("ClientSubscriptions")
  clientRecurringSlots RecurringSlot[] @relation("ClientRecurringSlots")
  barberRecurringSlots RecurringSlot[] @relation("BarberRecurringSlots")

  @@map("profiles")
}

model Service {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  barberId    String?  @map("barber_id") @db.Uuid
  name        String
  description String?
  durationMin Int      @map("duration_min")
  price       Float
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")

  appointmentServices AppointmentService[]

  @@map("services")
}

model Appointment {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId           String?  @map("client_id") @db.Uuid
  barberId           String   @map("barber_id") @db.Uuid
  startTime          DateTime @map("start_time")
  endTime            DateTime @map("end_time")
  totalPrice         Float    @map("total_price")
  status             String   @default("PENDING")
  clientName         String?  @map("client_name")
  clientPhone        String?  @map("client_phone")
  clientNotes        String?  @map("client_notes")
  googleEventId      String?  @map("google_event_id")
  wpConfirmationSent Boolean  @default(false) @map("wp_confirmation_sent")
  wpReminder24hSent  Boolean  @default(false) @map("wp_reminder_24h_sent")
  wpReminder2hSent   Boolean  @default(false) @map("wp_reminder_2h_sent")
  createdAt          DateTime @default(now()) @map("created_at")

  client   User?                @relation("ClientAppointments", fields: [clientId], references: [id])
  barber   User                 @relation("BarberAppointments", fields: [barberId], references: [id])
  services AppointmentService[]

  @@index([barberId, startTime])
  @@map("appointments")
}

model AppointmentService {
  appointmentId String @map("appointment_id") @db.Uuid
  serviceId     String @map("service_id") @db.Uuid
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service       Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([appointmentId, serviceId])
  @@map("appointment_services")
}

model BlockedTime {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  barberId  String   @map("barber_id") @db.Uuid
  startTime DateTime @map("start_time")
  endTime   DateTime @map("end_time")
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")
  barber    User     @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@map("blocked_times")
}

model Waitlist {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId    String?  @map("client_id") @db.Uuid
  barberId    String   @map("barber_id") @db.Uuid
  date        String   // YYYY-MM-DD
  status      String   @default("WAITING") // WAITING, NOTIFIED, CANCELLED
  clientName  String   @map("client_name")
  clientPhone String   @map("client_phone")
  createdAt   DateTime @default(now()) @map("created_at")

  client User? @relation("ClientWaitlist", fields: [clientId], references: [id])
  barber User  @relation("BarberWaitlist", fields: [barberId], references: [id])

  @@map("waitlists")
}

model SubscriptionPlan {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  price         Float
  cutsPerPeriod Int      @map("cuts_per_period")
  description   String?
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  subscriptions CustomerSubscription[]

  @@map("subscription_plans")
}

model CustomerSubscription {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId              String   @map("client_id") @db.Uuid
  planId                String   @map("plan_id") @db.Uuid
  status                String   @default("ACTIVE") // ACTIVE, PAST_DUE, CANCELED
  gatewaySubscriptionId String?  @map("gateway_subscription_id") // Futuro ID da Cakto ou Stripe
  nextBillingDate       DateTime? @map("next_billing_date")
  createdAt             DateTime @default(now()) @map("created_at")

  client User             @relation("ClientSubscriptions", fields: [clientId], references: [id])
  plan   SubscriptionPlan @relation(fields: [planId], references: [id])

  @@map("customer_subscriptions")
}

model RecurringSlot {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  barberId   String   @map("barber_id") @db.Uuid
  dayOfWeek  Int      @map("day_of_week") // 0 (Domingo) a 6 (Sábado)
  time       String   // "17:00"
  createdAt  DateTime @default(now()) @map("created_at")

  customer   User     @relation("ClientRecurringSlots", fields: [customerId], references: [id])
  barber     User     @relation("BarberRecurringSlots", fields: [barberId], references: [id])
  exceptions SlotException[]

  @@map("recurring_slots")
}

model SlotException {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recurringSlotId String   @map("recurring_slot_id") @db.Uuid
  originalDate    String   @map("original_date") // "YYYY-MM-DD"
  newDate         String?  @map("new_date")      // "YYYY-MM-DD", nulo se for cancelado
  newTime         String?  @map("new_time")      // "18:00", nulo se for cancelado
  status          String   @default("RESCHEDULED") // RESCHEDULED, CANCELED
  createdAt       DateTime @default(now()) @map("created_at")

  recurringSlot RecurringSlot @relation(fields: [recurringSlotId], references: [id], onDelete: Cascade)

  @@map("slot_exceptions")
}
